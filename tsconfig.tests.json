{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".test-dist",
    "noEmit": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "types": ["node"],
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": ["tests/**/*.ts", "server/tests/**/*.ts", "server/src/**/*.ts", "lib/**/*.ts", "data/**/*.ts"],
  "exclude": ["node_modules", ".test-dist"]
}
