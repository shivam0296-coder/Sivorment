{
  "name": "sivorment",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .test-dist --ignore-pattern server/dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "api:dev": "tsx server/src/index.ts",
    "api:build": "tsc -p server/tsconfig.json",
    "api:start": "node server/dist/server/src/index.js",
    "test": "tsc -p tsconfig.tests.json && node --test .test-dist/tests/*.test.js .test-dist/server/tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "3.0.2",
    "cors": "2.8.5",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "next": "16.2.6",
    "pg": "8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.3",
    "@types/jsonwebtoken": "9.0.10",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
